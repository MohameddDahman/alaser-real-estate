# Copy to .env.local. Never commit .env.local.

# Canonical origin, used for sitemap, robots and absolute OG URLs.
NEXT_PUBLIC_SITE_URL="https://alaser.eg"

# --- Admin ------------------------------------------------------------------
# One shared password and a signed session cookie.
# Generate the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The secret also derives the key the dashboard's stored data is encrypted
# with: changing it makes that data unreadable unless DATA_SECRET is set to
# its old value first.
ADMIN_SESSION_SECRET=""
ADMIN_PASSWORD=""

# --- Blob storage (photos, and the dashboard's data) ------------------------
# Provisioned with: vercel blob create-store <name> --access public --yes
# The CLI links it to the project and sets this automatically in all envs.
# Admin edits and enquiries are stored here too, encrypted.
BLOB_READ_WRITE_TOKEN=""
# Optional: an encryption key of its own, instead of ADMIN_SESSION_SECRET.
# DATA_SECRET=""
# Development writes to .data/ so it can never touch live data; set this to
# use the Blob store locally instead.
# ALASER_STORE="blob"

# --- Convex (optional, not provisioned) --------------------------------------
# NEXT_PUBLIC_CONVEX_URL=""
# CONVEX_DEPLOYMENT=""

# --- Better Auth (optional, with Convex) ------------------------------------
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"
