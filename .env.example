# Copy to .env.local. Never commit .env.local.

# Canonical origin, used for sitemap, robots and absolute OG URLs.
NEXT_PUBLIC_SITE_URL="https://alaser.eg"

# --- Admin (interim gate) --------------------------------------------------
# Replaced by Better Auth + the Convex adapter in the final step.
# Generate the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""
ADMIN_PASSWORD=""

# --- Blob storage (dashboard photo uploads) --------------------------------
# Provisioned with: vercel blob create-store <name> --access public --yes
# The CLI links it to the project and sets this automatically in all envs.
# Replaced by Convex storage in the final step.
BLOB_READ_WRITE_TOKEN=""

# --- Convex (final step, not yet provisioned) ------------------------------
# Created by `npx convex dev` once the client's account exists.
# NEXT_PUBLIC_CONVEX_URL=""
# CONVEX_DEPLOYMENT=""

# --- Better Auth (final step) ----------------------------------------------
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"
