# Copy to .env.local. Never commit .env.local.

# Canonical origin, used for sitemap, robots and absolute OG URLs.
NEXT_PUBLIC_SITE_URL="https://alaser.eg"

# --- Admin ------------------------------------------------------------------
# One shared password and a signed session cookie.
# Generate the secret with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""
ADMIN_PASSWORD=""

# --- Convex (photos, edits and enquiries) ---------------------------------
# The client's project is alaser-realestate. `npx convex dev` writes
# CONVEX_DEPLOYMENT and NEXT_PUBLIC_CONVEX_URL (the dev deployment) here.
# CONVEX_URL="https://<deployment>.convex.cloud"   # set on Vercel per environment
# Server-only key every Convex function checks. Set the same value on the
# deployment:  npx convex env set ALASER_SERVER_KEY <value>   (--prod for live)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ALASER_SERVER_KEY=""
# Development writes to .data/ so it can never touch live data; set this to
# use Convex (the dev deployment) locally instead. Photo uploads always go to
# the dev deployment locally.
# ALASER_STORE="convex"

# --- Better Auth (optional, with Convex) ------------------------------------
# BETTER_AUTH_SECRET=""
# BETTER_AUTH_URL="http://localhost:3000"
